left2middle_ADDR[9|8],S1END[3|2]

left2middle_WDATA[9|8|7|6|5|4|3|2|1|0],{10}GND0
left2middle_WDATA[9|8|7|6|5|4|3|2|1|0],{10}VCC0
left2middle_WDATA[9|8|7|6|5|4|3|2|1|0],S4END[9|8|7|6|5|4|3|2|1|0]
left2middle_WDATA[7|6|5|4|3|2|1|0],S2MID[7|6|5|4|3|2|1|0]
left2middle_WDATA[9|8],S1END[1|0]

